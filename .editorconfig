root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{js,ts,tsx,jsx,json,yml,yaml,graphql,graphqls}]
indent_style = space
indent_size = 2

[*.{py}]
indent_style = space
indent_size = 4

[*.{kt,kts,java}]
indent_style = space
indent_size = 4

[*.{go}]
indent_style = tab
indent_size = 4

[*.{tf,hcl}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab

[Dockerfile]
indent_style = space
indent_size = 4
